# DesiConnections Environment Variables Example
# Copy to .env.local for local development

# Resend API Key for transactional emails (team alerts & auto-replies)
RESEND_API_KEY=re_123456789_placeholder

# Optional Webhook URL for CRM / Google Sheets lead intake
LEADS_WEBHOOK_URL=https://hook.example.com/leads

# Notification destination for the DesiConnections concierge team
TEAM_NOTIFICATION_EMAIL=concierge@desiconnections.club
